# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Required ---
OPENAI_API_KEY=

# --- Model selection (Phase 1 has exactly one model switch) ---
READ_LOOP_MODEL=gpt-5.4-mini

# --- GitHub (optional: raises API rate limits, enables private repos and PRs) ---
GITHUB_PERSONAL_ACCESS_TOKEN=

# --- Runtime ---
FLASK_SECRET_KEY=
LOG_LEVEL=INFO

# Where cloned repositories are stored. Leave blank for a sensible local
# default (%LOCALAPPDATA% on Windows, ~/.local/share elsewhere).
#
# Do NOT point this inside OneDrive, Dropbox, or Google Drive. Sync clients
# open handles on files as git creates them, so clones fail intermittently
# with "could not lock config file" — and every cloned repo gets uploaded to
# your cloud storage quota.
WORKSPACE_ROOT=

# --- Storage (Phase 8) ---
# memory = bounded process-local; sqlite/postgres = durable
CONVERSATION_STORE=sqlite
DATABASE_URL=sqlite:///instance/app.db

# --- Budgets ---
REQUEST_TOKEN_BUDGET=120000
MAX_AGENT_STEPS=24
MAX_SUBAGENTS=4

# --- Sandbox (Phase 6) ---
# docker = disposable container; subprocess = bounded local fallback; auto = docker if reachable
SANDBOX_MODE=auto
SANDBOX_IMAGE=python:3.12-slim
SANDBOX_TIMEOUT_SECONDS=300

# --- Auth / quotas (Phase 8) ---
AUTH_ENABLED=false
RATE_LIMIT_PER_MINUTE=30
DAILY_COST_LIMIT_USD=10.0
